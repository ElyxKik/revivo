rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /products/{id} {
      allow read, write: if isAdmin();
    }

    match /purchases/{id} {
      allow read, write: if isAdmin();
    }

    match /licenses/{id} {
      allow read, write: if isAdmin();
    }

    match /audit/{id} {
      allow read, write: if isAdmin();
    }
  }
}
